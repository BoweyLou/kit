{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/repo-contract-kit/learning-upstream-candidate.schema.json",
  "title": "Portable Upstream Learning Candidate",
  "description": "Bounded local source-review candidate derived only from a currently approved decision and its linked approved proposal. It excludes raw events, evidence, context, feedback, and repository paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "created_at",
    "policy_id",
    "lineage",
    "recommendation",
    "origin",
    "source_baseline",
    "privacy_label",
    "redaction_confirmed"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "candidate_id": {"type": "string", "pattern": "^upc-[0-9a-f]{20}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "policy_id": {"type": "string", "const": "supervised-learning"},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "proposal_id"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^dec-[0-9a-f]{20}$"},
        "proposal_id": {"type": "string", "pattern": "^prop-[0-9a-f]{20}$"}
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "scope", "recommended_change"],
      "properties": {
        "classification": {"type": "string", "enum": ["documentation", "workflow", "policy", "harness", "process", "other"]},
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "recommended_change": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository_id"],
      "properties": {
        "kind": {"type": "string", "const": "sanitized-target"},
        "repository_id": {"type": "string", "pattern": "^repo-[0-9a-f]{20}$"}
      }
    },
    "source_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "version"],
      "properties": {
        "source_ref": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "privacy_label": {"type": "string", "enum": ["public-ok", "internal"]},
    "redaction_confirmed": {"type": "boolean", "const": true}
  }
}
